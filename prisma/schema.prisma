generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  RESCHEDULED
  COMPLETED
}

enum ContactMethod {
  PHONE
  EMAIL
  SMS
  WHATSAPP
}

enum PaymentType {
  DEPOSIT
  FULL
  GIFT_CARD
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String
  createdAt DateTime  @default(now())
  bookings  Booking[]
  messages  Message[]
  reviews   Review[]

  @@index([email])
  @@index([phone])
}

model Service {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String
  durationMin Int
  priceCents  Int
  imageUrl    String
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  bookings    Booking[]
}

model Booking {
  id             String        @id @default(cuid())
  bookingCode    String        @unique // e.g. SPA-20260725-0001
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  serviceId      String
  service        Service       @relation(fields: [serviceId], references: [id])
  preferredDate  DateTime
  preferredTime  String
  contactMethod  ContactMethod
  notes          String?
  status         BookingStatus @default(PENDING)
  payments       Payment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([preferredDate])
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id])
  type            PaymentType
  amountCents     Int
  status          PaymentStatus @default(PENDING)
  stripeSessionId String?
  createdAt       DateTime      @default(now())
}

model Message {
  id         String   @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  name       String
  email      String
  message    String
  createdAt  DateTime @default(now())
}

model Review {
  id         String   @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  name       String
  rating     Int
  comment    String
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())
}
